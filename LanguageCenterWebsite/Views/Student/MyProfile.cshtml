@model LanguageCenterWebsite.Models.Student

@{
ViewBag.Title = "My Profile";
}

<div class="text-center mb-5">
    <h1 class="fw-bold" style="font-weight:800;color:#0f172a;">
        My Profile
    </h1>

    <p class="text-muted">
        Manage your personal information and account security.
    </p>

    <div style="width:70px;height:4px;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:2px;margin:0 auto;"></div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm">
        @TempData["Error"]
    </div>
}

<div class="card border-0 shadow-sm rounded-4">

    <div class="card-header text-white"
         style="background:linear-gradient(135deg,#2563eb,#7c3aed);">

        <h4 class="mb-0">
            Personal Information
        </h4>

    </div>

    <div class="card-body p-4">

        @using (Html.BeginForm(
            "UpdateProfile",
            "Student",
            FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {

            <div class="text-center mb-4">

                @if (Model != null &&
                     !string.IsNullOrEmpty(Model.avatar))
                {
                    <img src="@Model.avatar"
                         class="rounded-circle shadow"
                         style="width:160px;height:160px;object-fit:cover;border:5px solid #e0e7ff;" />
                }
                else
                {
                    <img src="https://via.placeholder.com/160"
                         class="rounded-circle shadow"
                         style="width:160px;height:160px;object-fit:cover;border:5px solid #e0e7ff;" />
                }

                <div class="mt-3">
                    <input type="file"
                           name="AvatarFile"
                           class="form-control" />
                </div>

            </div>

            <div class="form-group mb-3">
                <label class="fw-bold">
                    Student ID
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.StudentID"
                       readonly />
            </div>

            <div class="form-group mb-4">
                <label class="fw-bold">
                    Full Name
                </label>

                @Html.TextBoxFor(
                    m => m.fullName,
                    new
                    {
                        @class = "form-control"
                    })
            </div>

            <div class="row">

                <div class="col-md-6">
                    <button type="submit"
                            class="btn btn-primary btn-block"
                            style="background:linear-gradient(135deg,#2563eb,#7c3aed);border:0;">
                        Update Profile
                    </button>
                </div>

                <div class="col-md-6">
                    <button type="button"
                            class="btn btn-warning btn-block text-white"
                            onclick="togglePasswordForm()">
                        Change Password
                    </button>
                </div>

            </div>
        }

    </div>

</div>

<div id="passwordForm"
     class="card border-0 shadow-sm rounded-4 mt-4"
     style="display:none;">

    <div class="card-header text-white"
         style="background:linear-gradient(135deg,#f59e0b,#ef4444);">

        <h4 class="mb-0">
            Change Password
        </h4>

    </div>

    <div class="card-body">

        @using (Html.BeginForm(
            "ChangePassword",
            "Student",
            FormMethod.Post))
        {
            <div class="form-group">
                <label>Current Password</label>
                <input type="password"
                       name="oldPassword"
                       class="form-control"
                       required />
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="password"
                       name="newPassword"
                       class="form-control"
                       required />
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password"
                       name="confirmPassword"
                       class="form-control"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-danger">
                Update Password
            </button>
        }

    </div>

</div>

<script>
    function togglePasswordForm() {

        var form = document.getElementById("passwordForm");

        if (form.style.display === "none") {
            form.style.display = "block";
        }
        else {
            form.style.display = "none";
        }
    }
</script>