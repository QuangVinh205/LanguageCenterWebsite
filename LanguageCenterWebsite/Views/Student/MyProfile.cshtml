@model LanguageCenterWebsite.Models.Student

@{
    ViewBag.Title = "My Profile";
}

<div class="container my-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold"
            style="font-weight:800;color:#0f172a;">
            My Profile
        </h1>

        <p class="text-muted">
            Manage your personal information and account security.
        </p>

        <div style="width:70px;
                    height:4px;
                    background:linear-gradient(90deg,#3b82f6,#8b5cf6);
                    border-radius:2px;
                    margin:0 auto;">
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-4">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-4">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header text-white p-4 border-0"
             style="background:linear-gradient(135deg,#2563eb,#7c3aed);">

            <h4 class="mb-0 fw-bold">
                Personal Information
            </h4>

        </div>

        <div class="card-body p-5">

            @using (Html.BeginForm(
                "UpdateProfile",
                "Student",
                FormMethod.Post,
                new { enctype = "multipart/form-data" }))
            {

                <div class="row align-items-center g-5">

                    <!-- AVATAR BÊN TRÁI -->
                    <div class="col-lg-4 text-center">

                        @if (!string.IsNullOrEmpty(Model.avatar))
                        {
                            <img src="@Model.avatar"
                                 alt="@Model.fullName"
                                 class="shadow-sm"
                                 style="width:250px;
                        height:320px;
                        object-fit:cover;
                        border-radius:20px;
                        border:4px solid rgba(59,130,246,.15);" />
                        }
                        else
                        {
                            <img src="@Url.Content("~/Content/img/default-user.jpg")"
                                 alt="Default Avatar"
                                 class="shadow-sm"
                                 style="width:250px;
                        height:320px;
                        object-fit:cover;
                        border-radius:20px;
                        border:4px solid rgba(59,130,246,.15);" />
                        }

                        <div class="mt-3">
                            <input type="file"
                                   name="AvatarFile"
                                   class="form-control rounded-3" />
                        </div>

                    </div>

                    <!-- THÔNG TIN BÊN PHẢI -->
                    <div class="col-lg-8">

                        <div class="mb-4">

                            <label class="fw-bold text-muted mb-2">
                                Student ID
                            </label>

                            <input type="text"
                                   class="form-control form-control-lg rounded-3"
                                   value="@Model.StudentID"
                                   readonly />

                        </div>

                        <div class="mb-4">

                            <label class="fw-bold text-muted mb-2">
                                Full Name
                            </label>

                            @Html.TextBoxFor(
                                m => m.fullName,
                                new
                                {
                                    @class = "form-control form-control-lg rounded-3"
                                })

                        </div>

                        <div class="mt-4 d-flex gap-3 flex-wrap">

                            <button type="submit"
                                    class="btn btn-primary px-4 py-2 fw-bold rounded-3 border-0"
                                    style="background:linear-gradient(135deg,#2563eb,#7c3aed);">

                                Update Profile

                            </button>

                            <button type="button"
                                    class="btn btn-warning text-white px-4 py-2 fw-bold rounded-3 border-0"
                                    onclick="togglePasswordForm()">

                                Change Password

                            </button>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>

    <!-- CHANGE PASSWORD -->

    <div id="passwordForm"
         class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4"
         style="display:none;">

        <div class="card-header text-white p-4 border-0"
             style="background:linear-gradient(135deg,#f59e0b,#ef4444);">

            <h4 class="mb-0 fw-bold">
                Change Password
            </h4>

        </div>

        <div class="card-body p-5">

            @using (Html.BeginForm(
                "ChangePassword",
                "Student",
                FormMethod.Post))
            {

                <div class="mb-4">

                    <label class="fw-bold text-muted mb-2">
                        Current Password
                    </label>

                    <input type="password"
                           name="oldPassword"
                           class="form-control form-control-lg rounded-3"
                           required />

                </div>

                <div class="mb-4">

                    <label class="fw-bold text-muted mb-2">
                        New Password
                    </label>

                    <input type="password"
                           name="newPassword"
                           class="form-control form-control-lg rounded-3"
                           required />

                </div>

                <div class="mb-4">

                    <label class="fw-bold text-muted mb-2">
                        Confirm Password
                    </label>

                    <input type="password"
                           name="confirmPassword"
                           class="form-control form-control-lg rounded-3"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-danger px-4 py-2 fw-bold rounded-3 border-0">

                    Update Password

                </button>

            }

        </div>

    </div>

</div>

<script>
    function togglePasswordForm() {

        var form = document.getElementById("passwordForm");

        if (form.style.display === "none") {
            form.style.display = "block";
        }
        else {
            form.style.display = "none";
        }
    }
</script>