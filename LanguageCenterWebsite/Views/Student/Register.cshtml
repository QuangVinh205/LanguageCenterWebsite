@model LanguageCenterWebsite.Models.Class

@{
    ViewBag.Title = "Register Class";
}

<div class="container my-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header text-white p-4 border-0"
                     style="background:linear-gradient(135deg,#2563eb,#7c3aed);">

                    <h2 class="mb-1 fw-bold">
                        Class Registration
                    </h2>

                    <p class="mb-0 opacity-75">
                        Complete your registration information
                    </p>

                </div>

                <div class="card-body p-5">

                    <!-- Class Info -->
                    <div class="rounded-4 p-4 mb-4"
                         style="background:#f8fafc;border:1px solid #e2e8f0;">

                        <h4 class="fw-bold mb-3 text-dark">
                            @Model.className
                        </h4>

                        <div class="row">

                            <div class="col-md-6">
                                <p>
                                    <strong>Room:</strong>
                                    @Model.room
                                </p>
                            </div>

                            <div class="col-md-6">
                                <p>
                                    <strong>Max Students:</strong>
                                    @Model.maxStudents
                                </p>
                            </div>

                        </div>

                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.Hidden("classId", Model.ClassID)

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input type="text"
                                   name="fullName"
                                   class="form-control form-control-lg"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Email
                            </label>

                            <input type="email"
                                   name="email"
                                   class="form-control form-control-lg"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input type="text"
                                   name="phone"
                                   class="form-control form-control-lg"
                                   required />

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Notes
                            </label>

                            <textarea name="note"
                                      rows="4"
                                      class="form-control"></textarea>

                        </div>

                        <div class="d-flex gap-3">

                            <a href="@Url.Action("ClassDetail","Home",new { id = Model.ClassID })"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-5 border-0"
                                    style="background:linear-gradient(135deg,#2563eb,#7c3aed);">

                                Register Now

                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>