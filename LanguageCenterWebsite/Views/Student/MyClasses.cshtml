@model IEnumerable<LanguageCenterWebsite.Models.Registration>

@{
    ViewBag.Title = "Lớp học của tôi";
}

<h2 style="margin-top:30px;">Danh sách lớp học đã đăng ký</h2>
<hr />

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
        <thead>
            <tr class="info">
                <th>Mã đăng ký</th>
                <th>Mã lớp học</th>
                <th>Ngày đăng ký</th>
                <th>Trạng thái duyệt</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.RegistrationID</td> @* Đổi thành tên cột ID khóa chính của bảng Registration nếu có biến động *@
                        <td>@item.classID</td>
                        <td>@(item.registrationDate.HasValue ? item.registrationDate.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                        <td>
                            @if (item.status == "Pending")
                            {
                                <span class="label label-warning">Chờ duyệt</span>
                            }
                            else if (item.status == "Approved")
                            {
                                <span class="label label-success">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="label label-danger">@item.status</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Bạn chưa đăng ký lớp học nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>