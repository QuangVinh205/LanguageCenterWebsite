@model IEnumerable<LanguageCenterWebsite.Models.Registration>
@{
    ViewBag.Title = "Lớp học của tôi";
}

<h2 style="margin-top:30px; color: #6f42c1; font-weight: bold;">Danh sách lớp học đã đăng ký</h2>
<hr />

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
        <thead>
            <tr style="background-color: #6f42c1; color: white;">
                <th class="text-center">Mã đăng ký</th>
                <th>Tên lớp học</th>
                <th>Lịch học</th>
                <th>Giáo viên</th>
                <th class="text-center">Ngày đăng ký</th>
                <th class="text-center">Trạng thái duyệt</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center" style="font-weight:bold;">@item.RegistrationID</td>

                        <td>
                            @(item.Class != null ? item.Class.className : "Mã lớp: " + item.classID)
                        </td>

                        <td>
                            <span class="text-muted"><i class="glyphicon glyphicon-calendar"></i> Xem lịch chi tiết</span>
                        </td>

                        <td>
                            @(item.Class != null && item.Class.teacherID != null ? item.Class.teacherID.ToString() : "Chưa phân công")
                        </td>

                        <td class="text-center">@(item.registrationDate.HasValue ? item.registrationDate.Value.ToString("dd/MM/yyyy") : "N/A")</td>

                        <td class="text-center">
                            @if (item.status == "Pending" || string.IsNullOrEmpty(item.status))
                            {
                                <span class="label label-warning" style="padding: 5px 10px; background-color: #ffc107; color: #fff; border-radius: 4px;">Chờ duyệt</span>
                            }
                            else if (item.status == "Approved" || item.status == "Active")
                            {
                                <span class="label label-success" style="padding: 5px 10px; background-color: #28a745; color: #fff; border-radius: 4px;">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="label label-danger" style="padding: 5px 10px; background-color: #dc3545; color: #fff; border-radius: 4px;">@item.status</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted" style="padding: 30px; font-style: italic;">Bạn chưa đăng ký lớp học nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>