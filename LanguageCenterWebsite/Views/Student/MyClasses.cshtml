@model IEnumerable<LanguageCenterWebsite.Models.Registration>

@{
    ViewBag.Title = "My Classes";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-weight:800;color:#0f172a;">
            My Registered Classes
        </h1>

        <p class="text-muted">
            Track your class registrations, schedule, teacher and approval status.
        </p>

        <div style="width:70px;height:4px;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:2px;margin:0 auto;"></div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="badge"
                                      style="background:rgba(59,130,246,.1);color:#2563eb;">
                                    Registration #@item.RegistrationID
                                </span>

                                @if (item.status == "Pending" || string.IsNullOrEmpty(item.status))
                                {
                                    <span class="badge" style="background:#f59e0b;">
                                        Pending
                                    </span>
                                }
                                else if (item.status == "Approved" || item.status == "Active")
                                {
                                    <span class="badge" style="background:#22c55e;">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#ef4444;">
                                        @item.status
                                    </span>
                                }

                            </div>

                            <h4 class="fw-bold mb-3" style="color:#0f172a;">
                                @(item.Class != null ? item.Class.className : "Class ID: " + item.classID)
                            </h4>

                            <p class="text-muted mb-2">
                                <strong>Schedule:</strong>
                                View class schedule
                            </p>

                            <p class="text-muted mb-2">
                                <strong>Teacher:</strong>
                                @(item.Class != null && item.Class.Teacher != null
                                    ? item.Class.Teacher.fullName
                                    : "Not Assigned")
                            </p>

                            <p class="text-muted mb-0">
                                <strong>Registration Date:</strong>
                                @(item.registrationDate.HasValue
                                    ? item.registrationDate.Value.ToString("dd/MM/yyyy")
                                    : "N/A")
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-5">
                <h3 class="text-muted">
                    You have not registered for any classes yet.
                </h3>

                <p class="text-secondary">
                    Browse our programs and register for a suitable class.
                </p>

                <a href="@Url.Action("ProgramList", "Home")"
                   class="btn btn-primary"
                   style="background:linear-gradient(135deg,#2563eb,#7c3aed);border:0;">
                    View Programs
                </a>
            </div>
        </div>
    }

</div>

<style>
    .hover-lift {
        transition: all .3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,.08) !important;
        }
</style>