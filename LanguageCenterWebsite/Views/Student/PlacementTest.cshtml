@model IEnumerable<LanguageCenterWebsite.Models.PlacementTest>

@{
    ViewBag.Title = "Placement Test";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-weight:800;color:#0f172a;">
            Placement Test
        </h1>

        <p class="text-muted">
            View your placement test registration and results.
        </p>

        <div style="width:70px;height:4px;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:2px;margin:0 auto;"></div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="badge"
                                      style="background:rgba(59,130,246,.1);color:#2563eb;font-weight:700;">
                                    Test #@item.TestID
                                </span>

                                @if (item.status == "Completed")
                                {
                                    <span class="badge" style="background:#22c55e;">
                                        Completed
                                    </span>
                                }
                                else if (item.status == "Pending")
                                {
                                    <span class="badge" style="background:#f59e0b;">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#64748b;">
                                        @item.status
                                    </span>
                                }

                            </div>

                            <h3 class="fw-bold mb-3" style="color:#0f172a;">
                                @item.levelRequested
                            </h3>

                            <p class="text-muted mb-2">
                                <strong>Test Date:</strong>
                                @(item.testDate.HasValue
                                    ? item.testDate.Value.ToString("dd/MM/yyyy")
                                    : "N/A")
                            </p>

                            <p class="text-muted mb-2">
                                <strong>Test Time:</strong>
                                @(item.testTime.HasValue
                                    ? item.testTime.Value.ToString(@"hh\:mm")
                                    : "N/A")
                            </p>

                            <p class="text-muted mb-2">
                                <strong>Suggested Level:</strong>
                                @(string.IsNullOrEmpty(item.suggestedLevel)
                                    ? "N/A"
                                    : item.suggestedLevel)
                            </p>

                            <p class="text-muted mb-0">
                                <strong>Result Score:</strong>
                                @(item.resultScore.HasValue
                                    ? item.resultScore.Value.ToString("N1")
                                    : "N/A")
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-5">
                <h3 class="text-muted">
                    No placement test found.
                </h3>

                <p class="text-secondary">
                    Your placement test information will appear here.
                </p>
            </div>
        </div>
    }

</div>

<style>
    .hover-lift {
        transition: all .3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,.08) !important;
        }
</style>