@model IEnumerable<LanguageCenterWebsite.Models.PlacementTest>

@{
    ViewBag.Title = "Placement Test";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            Placement Test Registration
        </h2>

        <p class="text-muted">
            Register for an English placement test to determine the most suitable class level.
        </p>
    </div>

    <div class="row">

        <!-- FORM -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <strong>Register New Test</strong>
                </div>

                <div class="card-body">

                    @using (Html.BeginForm("RegisterPlacementTest",
                                           "Student",
                                           FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label class="form-label">
                                Test Date
                            </label>

                            <input type="date"
                                   name="testDate"
                                   class="form-control"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Test Session
                            </label>

                            <select name="testTime"
                                    class="form-control"
                                    required>

                                <option value="08:00">
                                    08:00 - Morning
                                </option>

                                <option value="14:00">
                                    14:00 - Afternoon
                                </option>

                                <option value="18:00">
                                    18:00 - Evening
                                </option>

                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Desired Level
                            </label>

                            <input type="text"
                                   name="level"
                                   class="form-control"
                                   placeholder="Beginner, IELTS, TOEIC..."
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">

                            Register

                        </button>
                    }

                </div>

            </div>

        </div>

        <!-- HISTORY -->
        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>
                        Test Registration History
                    </strong>
                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle">

                            <thead class="table-primary">

                                <tr>
                                    <th>ID</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Level</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>

                                            <td>
                                                @item.TestID
                                            </td>

                                            <td>
                                                @(item.testDate != null
                                                    ? Convert.ToDateTime(item.testDate)
                                                        .ToString("dd/MM/yyyy")
                                                    : "")
                                            </td>

                                            <td>
                                                @item.testTime
                                            </td>

                                            <td>
                                                @item.suggestedLevel
                                            </td>

                                            <td>

                                                @if (item.status == "Pending" ||
                                                     string.IsNullOrEmpty(item.status))
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Pending
                                                    </span>
                                                }
                                                else if (item.status == "Approved")
                                                {
                                                    <span class="badge bg-success">
                                                        Approved
                                                    </span>
                                                }
                                                else if (item.status == "Completed")
                                                {
                                                    <span class="badge bg-info">
                                                        Completed
                                                    </span>
                                                }
                                                else if (item.status == "Rejected")
                                                {
                                                    <span class="badge bg-danger">
                                                        Rejected
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        @item.status
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="5"
                                            class="text-center text-muted">

                                            No placement test registration found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>