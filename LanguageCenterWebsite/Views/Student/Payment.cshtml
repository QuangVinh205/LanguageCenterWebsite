@model IEnumerable<LanguageCenterWebsite.Models.Payment>

@{
    ViewBag.Title = "Payment History";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-weight:800;color:#0f172a;">
            Payment History
        </h1>

        <p class="text-muted">
            View your tuition payment records and payment status.
        </p>

        <div style="width:70px;height:4px;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:2px;margin:0 auto;"></div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="badge"
                                      style="background:rgba(59,130,246,.1);color:#2563eb;">
                                    Invoice #@item.PaymentID
                                </span>

                                @if (item.paymentStatus == "Paid" || item.paymentStatus == "Đã đóng")
                                {
                                    <span class="badge" style="background:#22c55e;">
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#ef4444;">
                                        Unpaid
                                    </span>
                                }

                            </div>

                            <h3 class="fw-bold mb-3" style="color:#16a34a;">
                                @item.amount.ToString("N0")đ
                            </h3>

                            <p class="text-muted mb-2">
                                <strong>Registration ID:</strong>
                                @item.registrationID
                            </p>

                            <p class="text-muted mb-0">
                                <strong>Payment Date:</strong>
                                @(item.paymentDate.HasValue
                                    ? item.paymentDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "N/A")
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-5">
                <h3 class="text-muted">
                    No payment history found.
                </h3>

                <p class="text-secondary">
                    Your tuition payment records will appear here.
                </p>
            </div>
        </div>
    }

</div>

<style>
    .hover-lift {
        transition: all .3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,.08) !important;
        }
</style>