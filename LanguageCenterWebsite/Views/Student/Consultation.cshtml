@model IEnumerable<LanguageCenterWebsite.Models.Consultation>

@{
    ViewBag.Title = "Consultation";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-weight:800;color:#0f172a;">
            Student Consultation
        </h1>

        <p class="text-muted">
            Send your questions and receive support from our consultants.
        </p>

        <div style="width:70px;height:4px;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:2px;margin:0 auto;"></div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center shadow-sm">
            @TempData["Success"]
        </div>
    }

    <div class="row">

        <!-- FORM -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header text-white"
                     style="background:linear-gradient(135deg,#2563eb,#7c3aed);">

                    <h4 class="mb-0">
                        Send Consultation Request
                    </h4>

                </div>

                <div class="card-body p-4">

                    @using (Html.BeginForm("ConsultationRequest", "Student", FormMethod.Post))
                    {
                        <div class="form-group mb-3">
                            <label class="fw-bold">
                                Your Question
                            </label>

                            <textarea name="question"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter your question..."
                                      required></textarea>
                        </div>

                        <div class="form-group mb-4">
                            <label class="fw-bold">
                                Contact Information
                            </label>

                            <input type="text"
                                   name="contactInfo"
                                   class="form-control"
                                   placeholder="Phone number or email..."
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-block"
                                style="background:linear-gradient(135deg,#2563eb,#7c3aed);border:0;">
                            Submit Request
                        </button>
                    }

                </div>

            </div>

        </div>

        <!-- HISTORY -->
        <div class="col-md-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white">
                    <h4 class="fw-bold mb-0">
                        Consultation History
                    </h4>
                </div>

                <div class="card-body p-4">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <div class="card border-0 shadow-sm rounded-4 mb-3 hover-lift">

                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-center mb-2">

                                        <h5 class="fw-bold mb-0">
                                            Consultation Request
                                        </h5>

                                        @if (item.requestStatus == "Replied" ||
                                             item.requestStatus == "Đã trả lời")
                                        {
                                            <span class="badge"
                                                  style="background:#22c55e;">
                                                Replied
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge"
                                                  style="background:#f59e0b;">
                                                Pending
                                            </span>
                                        }

                                    </div>

                                    <p class="text-muted mb-2">
                                        @item.question
                                    </p>

                                    <hr />

                                    <small class="text-secondary">
                                        Contact:
                                        @(string.IsNullOrEmpty(item.phone)
                                            ? item.email
                                            : item.phone)
                                    </small>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <h4 class="text-muted">
                                No consultation requests yet
                            </h4>

                            <p class="text-secondary">
                                Submit your first question using the form on the left.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<style>
    .hover-lift {
        transition: all .3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0,0,0,.08) !important;
        }
</style>