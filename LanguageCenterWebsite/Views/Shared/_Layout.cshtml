<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Language Center</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("LANGUAGE CENTER", "Index", "Home", new { area = "" }, new { @class = "navbar-brand", @style = "font-weight:bold; color:#6f42c1;" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">

                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>

                    @if (Session["UserId"] != null)
                    {
                        if (Session["Role"]?.ToString() == "Student")
                        {
                            <li class="nav-item">@Html.ActionLink("My Profile", "MyProfile", "Student", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("My Classes", "MyClasses", "Student", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Consultation", "Consultation", "Student", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Payment", "Payment", "Student", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Placement Test", "PlacementTest", "Student", null, new { @class = "nav-link" })</li>
                        }
                        else if (Session["Role"]?.ToString() == "Teacher")
                        {
                            <li class="nav-item">@Html.ActionLink("Teacher Dashboard", "Index", "Teacher", null, new { @class = "nav-link" })</li>
                            <li class="nav-item"><a class="nav-link" href="#">My Schedule</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Manage Grades</a></li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("About Us", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link" style="color: #6f42c1; font-weight: bold;">
                                Hello, @(Session["FullName"] ?? Session["UserEmail"])!
                            </span>
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "nav-link", @style = "color: #dc3545; font-weight: bold;" })
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("Register", "Register", "Account", null, new { @class = "nav-link" })</li>
                        <li class="nav-item"><span class="nav-link" style="padding-left:0; padding-right:0; color:gray;">|</span></li>
                        <li class="nav-item">@Html.ActionLink("Login", "Login", "Account", null, new { @class = "nav-link", @style = "font-weight:bold; color:#6f42c1;" })</li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()

        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Vũ Khánh Hoàng - Language Center Project</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>