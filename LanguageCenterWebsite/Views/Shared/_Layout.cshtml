<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Language Center</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render("~/Content/PagedList.css")
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1e293b;
        }

        /* NAVBAR */
        .navbar-custom {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 16px 0;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: transform 0.2s ease;
        }

            .navbar-brand:hover {
                transform: scale(1.02);
            }

        .navbar-nav .nav-link {
            color: #94a3b8 !important;
            font-weight: 600;
            font-size: 14px;
            margin: 0 4px;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .navbar-nav .nav-link:hover {
                color: #f8fafc !important;
                background-color: rgba(255, 255, 255, 0.08);
            }

            /* Active link indicator */
            .navbar-nav .active > .nav-link,
            .navbar-nav .nav-link.active {
                color: #ffffff !important;
                background-color: rgba(59, 130, 246, 0.15);
            }

        .navbar-toggler {
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 6px 12px;
            border-radius: 6px;
            outline: none;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
            }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        /* CONTENT */
        .body-content {
            min-height: 85vh;
            padding-top: 40px;
        }

        /* USER SECTIONS */
        .hello-user {
            color: #a78bfa !important;
            font-weight: 700;
            font-size: 14px;
            background: rgba(167, 139, 250, 0.12);
            padding: 8px 16px;
            border-radius: 8px;
            border: 1px solid rgba(167, 139, 250, 0.2);
        }
        .user-dropdown {
            position: relative;
        }

        .user-dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 48px;
            min-width: 220px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 16px 40px rgba(0,0,0,.15);
            padding: 12px;
            z-index: 9999;
        }

            .user-dropdown-menu.show {
                display: block;
            }

        .dropdown-link {
            display: block;
            padding: 10px 14px;
            color: #334155;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
        }

            .dropdown-link:hover {
                background: #f1f5f9;
                color: #2563eb;
                text-decoration: none;
            }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom">

        <div class="container">

            @Html.ActionLink("LANGUAGE CENTER", "Index","Home", new {area = ""}, new { @class = "navbar-brand" })

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainMenu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="mainMenu">

                <!-- LEFT MENU -->
                <ul class="navbar-nav">

                    <li class="nav-item">
                        @Html.ActionLink("Home",
                            "Index",
                            "Home",
                            new { area = "" },
                            new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Programs",
                            "ProgramList",
                            "Home",
                            new { area = "" },
                            new { @class = "nav-link" })
                    </li>

                    @* Các menu Student / Teacher / Admin giữ nguyên *@

                </ul>

                <!-- RIGHT MENU -->
                <ul class="navbar-nav ms-auto">

                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item user-dropdown">

                            <a href="javascript:void(0)"
                               class="nav-link hello-user"
                               onclick="toggleUserMenu()">
                                Hello, @(Session["FullName"] ?? Session["UserEmail"])
                            </a>

                            <div id="userMenu" class="user-dropdown-menu">

                                @if (Session["Role"] != null && Session["Role"].ToString() == "Student")
                                {
                                    @Html.ActionLink("My Profile", "MyProfile", "Student", null, new { @class = "dropdown-link" })
                                    @Html.ActionLink("My Classes", "MyClasses", "Student", null, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Payment", "Payment", "Student", null, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Placement Test", "PlacementTest", "Student", null, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Consultation", "Consultation", "Student", null, new { @class = "dropdown-link" })
                                }

                                @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                                {
                                    @Html.ActionLink("Admin Dashboard", "Index", "Dashboard", new { area = "Admin" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Programs", "Index", "Program", new { area = "Admin" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Teachers", "Index", "Teacher", new { area = "Admin" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Students", "Index", "Student", new { area = "Admin" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Classes", "Index", "Class", new { area = "Admin" }, new { @class = "dropdown-link" })
                                }

                                @if (Session["Role"] != null && Session["Role"].ToString() == "Teacher")
                                {
                                    @Html.ActionLink("Profile", "Profile", "Teacher", new { area = "" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Teacher Dashboard", "Index", "Teacher", new { area = "" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("My Classes", "MyClasses", "Teacher", new { area = "" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Placement Test", "PlacementTestResults", "Teacher", new { area = "" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Class Students", "ClassStudents", "Teacher", new { area = "" }, new { @class = "dropdown-link" })
                                    @Html.ActionLink("Feed Back", "StudentFeedback", "Teacher", new { area = "" }, new { @class = "dropdown-link" })

                                    

                                }
                                <hr />

                                @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "dropdown-link text-danger fw-bold" })

                            </div>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Register", "Register", "Account", null, new { @class = "nav-link" })
                        </li>

                        <li class="nav-item ms-2">
                            @Html.ActionLink(
                                "Login",
                                "Login",
                                "Account",
                                null,
                                new
                                {
                                    @class = "btn btn-primary rounded-3 px-3",
                                    style = "background:linear-gradient(135deg,#2563eb,#7c3aed);border:none;"
                                })
                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <!-- CONTENT -->
    <div class="container body-content">

        @RenderBody()

    </div>

    <!-- FOOTER -->
    <footer class="footer-custom">

        <div class="container">

            <div class="row text-center">

                <div class="col-md-3">
                    <h4>Language Center</h4>
                    <p>Learn English<br />Build Your Future</p>
                </div>

                <div class="col-md-3">
                    <h4>Contact</h4>
                    <p>support@languagecenter.com</p>
                    <p>0123 456 789</p>
                </div>

                <div class="col-md-3">
                    <h4>Programs</h4>
                    <p>English Communication</p>
                    <p>IELTS Preparation</p>
                    <p>TOEIC Preparation</p>
                </div>

                <div class="col-md-3">
                    <h4>Follow Us</h4>
                    <p>Facebook</p>
                    <p>Instagram</p>
                    <p>YouTube</p>
                </div>

            </div>

            <hr style="border-color:rgba(255,255,255,0.3);" />

            <div class="text-center">
                © @DateTime.Now.Year - Language Center Management System
            </div>

        </div>

    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>

<script>
    function toggleUserMenu() {
        var menu = document.getElementById("userMenu");
        menu.classList.toggle("show");
    }
    document.addEventListener("click", function (event) {
        var dropdown = document.querySelector(".user-dropdown");
        var menu = document.getElementById("userMenu");

        if (dropdown && menu && !dropdown.contains(event.target)) {
            menu.classList.remove("show");
        }
    });
</script>