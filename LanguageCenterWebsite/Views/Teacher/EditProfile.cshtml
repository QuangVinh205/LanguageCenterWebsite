@model LanguageCenterWebsite.Models.EditTeacherProfileViewModel

@{
    ViewBag.Title = "Edit Profile";
}

<div class="container mt-4">
    <div class="panel panel-primary shadow">
        <div class="panel-heading">
            <h3 class="panel-title">Edit Profile</h3>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("EditProfile", "Teacher", FormMethod.Post,
                new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.TeacherID)

                <div class="row">

                    <!-- LEFT -->
                    <div class="col-md-4 text-center">

                        @if (!string.IsNullOrEmpty(Model.Avatar))
                        {
                            <img src="@Url.Content(Model.Avatar)"
                                 class="img-thumbnail"
                                 style="width:250px;height:300px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="~/Content/default-avatar.png"
                                 class="img-thumbnail"
                                 style="width:250px;height:300px;object-fit:cover;" />
                        }

                        <div class="form-group" style="margin-top:15px;">
                            <label><strong>Change Avatar</strong></label>
                            <input type="file"
                                   name="uploadAvatar"
                                   class="form-control" 
                                   style="margin-left: 10px;" />
                        </div>

                    </div>

                    <!-- RIGHT -->
                    <div class="col-md-8">

                        <div class="form-group">
                            @Html.LabelFor(m => m.FullName, "Full Name")
                            @Html.TextBoxFor(m => m.FullName,
                                new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Email, "Email")
                            @Html.TextBoxFor(m => m.Email,
                                new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly"
                                })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Expertise, "Expertise")
                            @Html.TextBoxFor(m => m.Expertise,
                                new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(m => m.Bio, "Bio")
                            @Html.TextAreaFor(m => m.Bio,
                                new
                                {
                                    @class = "form-control",
                                    rows = 8
                                })
                        </div>
                        <div class="btn-action">
                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            @Html.ActionLink(
                                "Cancel",
                                "Profile",
                                "Teacher",
                                null,
                                new { @class = "btn btn-default" })
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>

</div>

<style>
    .panel-title {
        margin-left: 10px;
        padding-top: 10px;
    }
    .profile-info {
        padding-left: 35px;
    }
    .btn-action {
        margin: 10px 0 10px 0;
        
    }
    .uploadAvatar {
        margin-left: 10px;
        padding-top: 10px;
    }

    .profile-info .form-group {
        margin-bottom: 18px;
    }

        .profile-info label {
            margin-bottom: 6px;
            font-weight: 600;
        }

    
</style>