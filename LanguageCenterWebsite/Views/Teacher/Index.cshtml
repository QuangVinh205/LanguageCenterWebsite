@model LanguageCenterWebsite.Models.TeacherDashboardViewModel
@{
    ViewBag.Title = "Teacher Dashboard";
}

<div style="padding: 20px; font-family: Arial, sans-serif; max-width: 1200px; margin: 0 auto;">
    <h2 style="color: #2c3e50;">1/ Teacher Dashboard</h2>
    <p style="color: gray;">Chào mừng bạn quay trở lại hệ thống quản lý giảng dạy.</p>
    <hr />

    <!-- Khối thống kê nhanh (Widgets) -->
    <div style="display: flex; gap: 20px; margin-bottom: 30px;">
        <div style="flex: 1; background: #3498db; color: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <h3 style="margin: 0; font-size: 16px; text-transform: uppercase;">Tổng số lớp dạy</h3>
            <p style="margin: 10px 0 0 0; font-size: 36px; font-weight: bold;">@Model.TotalClasses</p>
        </div>
        <div style="flex: 1; background: #2ecc71; color: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <h3 style="margin: 0; font-size: 16px; text-transform: uppercase;">Tổng số học viên</h3>
            <p style="margin: 10px 0 0 0; font-size: 36px; font-weight: bold;">@Model.TotalStudents</p>
        </div>
    </div>

    <div style="display: flex; gap: 30px;">
        <!-- Cột lịch dạy -->
        <div style="flex: 2; background: #fdfefe; padding: 20px; border: 1px solid #e1e8ed; border-radius: 8px;">
            <h3 style="color: #34495e; margin-top: 0; border-bottom: 2px solid #3498db; padding-bottom: 8px;">Lịch giảng dạy hiện tại</h3>
            <table border="1" cellpadding="10" style="border-collapse: collapse; width: 100%; text-align: left; border: 1px solid #ddd; margin-top: 15px;">
                <thead style="background: #34495e; color: white;">
                    <tr>
                        <th>Thứ (Day)</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                        <th>Lớp học</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TeachingSchedule != null && Model.TeachingSchedule.Count > 0)
                    {
                        foreach (var schedule in Model.TeachingSchedule)
                        {
                            <tr>
                                <td><strong>@schedule.Day</strong></td>
                                <td style="color: #27ae60; font-weight: bold;">@schedule.Start</td>
                                <td style="color: #c0392b; font-weight: bold;">@schedule.End</td>
                                <td style="color: #2980b9; font-weight: 500;">@schedule.ClassName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: gray;">Bạn chưa có lịch dạy được phân công.</td>
                        </tr>
                    }
                </tbody>
            </table>

            <p style="margin-top: 20px;">
                <a href="@Url.Action("MyClasses", "Teacher")" style="background: #34495e; color: white; padding: 10px 15px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: bold;">
                    Quản lý các lớp dạy →
                </a>
            </p>
        </div>

        <!-- Cột hoạt động gần đây -->
        <div style="flex: 1; background: #fdfefe; padding: 20px; border: 1px solid #e1e8ed; border-radius: 8px;">
            <h3 style="color: #34495e; margin-top: 0; border-bottom: 2px solid #2ecc71; padding-bottom: 8px;">Hoạt động gần đây</h3>
            <ul style="list-style: none; padding-left: 0; margin-top: 15px;">
                @foreach (var activity in Model.RecentActivities)
                {
                    <li style="padding: 12px; border-bottom: 1px dashed #ddd; font-size: 14px; color: #555; background: #fafafa; margin-bottom: 8px; border-left: 4px solid #2ecc71; border-radius: 0 4px 4px 0;">
                        @activity
                    </li>
                }
            </ul>
        </div>
    </div>
</div>