@model LanguageCenterWebsite.Models.TeacherDashboardViewModel

@{
    ViewBag.Title = "Teacher Dashboard";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-weight:800;color:#0f172a;">
            Teacher Dashboard
        </h1>

        <p class="text-muted">
            Welcome back to your teaching management dashboard.
        </p>

        <div style="width:70px;height:4px;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:2px;margin:0 auto;"></div>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 text-white hover-lift"
                 style="background:linear-gradient(135deg,#2563eb,#7c3aed);">
                <div class="card-body p-4">
                    <p class="text-uppercase mb-2" style="opacity:.85;font-weight:700;">
                        Total Classes
                    </p>

                    <h1 class="fw-bold mb-0" style="font-weight:800;">
                        @Model.TotalClasses
                    </h1>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 text-white hover-lift"
                 style="background:linear-gradient(135deg,#10b981,#22c55e);">
                <div class="card-body p-4">
                    <p class="text-uppercase mb-2" style="opacity:.85;font-weight:700;">
                        Total Students
                    </p>

                    <h1 class="fw-bold mb-0" style="font-weight:800;">
                        @Model.TotalStudents
                    </h1>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-md-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white">
                    <h4 class="fw-bold mb-0" style="color:#0f172a;">
                        Current Teaching Schedule
                    </h4>
                </div>

                <div class="card-body p-4">

                    @if (Model.TeachingSchedule != null && Model.TeachingSchedule.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr style="background:#0f172a;color:white;">
                                        <th>Day</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Class</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var schedule in Model.TeachingSchedule)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge"
                                                      style="background:rgba(59,130,246,.1);color:#2563eb;">
                                                    @schedule.Day
                                                </span>
                                            </td>

                                            <td class="text-success fw-bold">
                                                @schedule.Start
                                            </td>

                                            <td class="text-danger fw-bold">
                                                @schedule.End
                                            </td>

                                            <td>
                                                <strong style="color:#0f172a;">
                                                    @schedule.ClassName
                                                </strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h4 class="text-muted">
                                No teaching schedule assigned.
                            </h4>

                            <p class="text-secondary">
                                Your assigned teaching schedule will appear here.
                            </p>
                        </div>
                    }

                    <a href="@Url.Action("MyClasses", "Teacher")"
                       class="btn btn-primary mt-3"
                       style="background:linear-gradient(135deg,#2563eb,#7c3aed);border:0;">
                        Manage My Classes →
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white">
                    <h4 class="fw-bold mb-0" style="color:#0f172a;">
                        Recent Activities
                    </h4>
                </div>

                <div class="card-body p-4">

                    @if (Model.RecentActivities != null && Model.RecentActivities.Count > 0)
                    {
                        foreach (var activity in Model.RecentActivities)
                        {
                            <div class="p-3 mb-3 rounded-4 hover-lift"
                                 style="background:rgba(16,185,129,.08);border-left:4px solid #10b981;">
                                <p class="mb-0 text-muted">
                                    @activity
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">
                                No recent activities.
                            </p>
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<style>
    .hover-lift {
        transition: all .3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,.08) !important;
        }
</style>