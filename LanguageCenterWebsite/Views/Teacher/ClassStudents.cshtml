@model List<LanguageCenterWebsite.Models.ClassStudentViewModel>

@{
    ViewBag.Title = "View Class Students";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-weight:800;color:#0f172a;">
            Class Students
        </h1>

        <p class="text-muted">
            View students registered in this class.
        </p>

        <div style="width:70px;height:4px;background:linear-gradient(90deg,#3b82f6,#8b5cf6);border-radius:2px;margin:0 auto;"></div>
    </div>

    <div class="card border-0 shadow-lg rounded-4 mb-4">
        <div class="card-body p-4 text-white"
             style="background:linear-gradient(135deg,#2563eb,#7c3aed);">

            <span class="badge bg-light text-primary mb-3">
                Teacher Module
            </span>

            <h2 class="fw-bold mb-0" style="font-weight:800;">
                @ViewBag.ClassName
            </h2>

        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr style="background:#0f172a;color:white;">
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>Registration Date</th>
                                <th>Payment Status</th>
                                <th>Attendance Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge"
                                              style="background:rgba(59,130,246,.1);color:#2563eb;">
                                            #@s.StudentID
                                        </span>
                                    </td>

                                    <td>
                                        <strong style="color:#0f172a;">
                                            @s.FullName
                                        </strong>
                                    </td>

                                    <td class="text-muted">
                                        @s.RegDate
                                    </td>

                                    <td>
                                        @if (s.PaymentStatus == "Confirmed" ||
                                             s.PaymentStatus == "Paid" ||
                                             s.PaymentStatus == "Đã đóng tiền")
                                        {
                                            <span class="badge" style="background:#22c55e;">
                                                Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background:#ef4444;">
                                                @s.PaymentStatus
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge"
                                              style="background:rgba(139,92,246,.1);color:#7c3aed;">
                                            @s.AttendanceStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h4 class="text-muted">
                        No students found in this class.
                    </h4>

                    <p class="text-secondary">
                        This class does not have any successful registrations yet.
                    </p>

                </div>
            }

        </div>

    </div>

    <div class="mt-4">
        <a href="@Url.Action("MyClasses", "Teacher")"
           class="btn btn-outline-primary">
            ← Back to My Classes
        </a>
    </div>

</div>