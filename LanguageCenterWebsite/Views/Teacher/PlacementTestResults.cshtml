@model IEnumerable<LanguageCenterWebsite.Models.PlacementTestViewModel>

@{
    ViewBag.Title = "Placement Test Results";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Đổi đường dẫn layout nếu trung tâm của bạn dùng file khác
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📊 Placement Test Results</h2>
        <p class="text-muted">Danh sách kết quả bài thi đánh giá năng lực đầu vào của học viên.</p>
    </div>

    <table class="table table-bordered table-striped table-hover text-center align-middle">
        <thead class="table-dark" style="background-color: #2c3e50; color: white;">
            <tr>
                <th style="width: 8%">Mã dòng</th>
                <th style="width: 25%">Student Name (Tên học viên)</th>
                <th style="width: 15%">Test Date (Ngày thi)</th>
                <th style="width: 25%">Suggested Level (Lớp đề xuất)</th>
                <th style="width: 15%">Result (Điểm số)</th>
                <th style="width: 12%">Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.TestID</strong></td>
                        <td class="text-start text-primary"><strong>@item.StudentName</strong></td>
                        <td>@item.TestDate</td>
                        <td><span class="badge bg-info text-dark" style="font-size: 14px; padding: 6px 12px;">@item.SuggestedLevel</span></td>
                        <td>
                            <strong style="color: #e74c3c; font-size: 16px;">@item.ResultScore</strong>
                        </td>
                        <td>
                            @if (item.Status.ToLower() == "completed")
                            {
                                <span class="text-success">● Đã hoàn thành</span>
                            }
                            else
                            {
                                <span class="text-warning">● Đang chờ</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-muted text-center py-4">Chưa có dữ liệu bài thi xếp lớp nào được ghi nhận.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a href="@Url.Action("MyClasses", "Teacher")" class="btn btn-secondary">← Quay lại danh sách lớp</a>
    </div>
</div>