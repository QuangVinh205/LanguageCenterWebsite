@model IEnumerable<LanguageCenterWebsite.Models.StudentFeedbackViewModel>

@{
    ViewBag.Title = "Student Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>💬 Student Feedback & Consultations</h2>
        <p class="text-muted">Danh sách ý kiến đóng góp, phản hồi và câu hỏi tư vấn từ học viên.</p>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle text-center">
        <thead class="table-dark" style="background-color: #2c3e50; color: white;">
            <tr>
                <th style="width: 8%">Mã số</th>
                <th style="width: 20%">Student Name (Người gửi)</th>
                <th style="width: 35%">Feedback Content (Nội dung phản hồi)</th>
                <th style="width: 15%">Rating (Đánh giá)</th>
                <th style="width: 12%">Feedback Date (Ngày gửi)</th>
                <th style="width: 10%">Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.FeedbackID</strong></td>
                        <td class="text-start"><strong>@item.StudentName</strong></td>
                        <td class="text-start text-muted" style="font-style: italic;">"@item.FeedbackContent"</td>
                        <td>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= item.Rating)
                                {
                                    <span style="color: #f1c40f; font-size: 18px;">★</span>
                                }
                                else
                                {
                                    <span style="color: #bdc3c7; font-size: 18px;">★</span>
                                }
                            }
                        </td>
                        <td>@item.FeedbackDate</td>
                        <td>
                            @if (item.Status.ToLower() == "pending")
                            {
                                <span class="badge bg-danger" style="padding: 6px 10px;">Chưa xử lý</span>
                            }
                            else
                            {
                                <span class="badge bg-success" style="padding: 6px 10px;">Đã liên hệ</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-muted text-center py-4">Chưa có phản hồi hoặc yêu cầu tư vấn nào.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a href="@Url.Action("MyClasses", "Teacher")" class="btn btn-secondary">← Quay lại danh sách lớp</a>
    </div>
</div>