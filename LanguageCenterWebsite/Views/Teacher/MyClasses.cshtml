@model List<LanguageCenterWebsite.Models.TeacherClassViewModel>
@{
    ViewBag.Title = "My Teaching Classes";
}

<div style="padding: 20px; font-family: Arial, sans-serif; max-width: 1200px; margin: 0 auto;">
    <h2 style="color: #2c3e50;">2/ My Teaching Classes</h2>
    <p style="color: gray;">Danh sách toàn bộ các lớp học do bạn chịu trách nhiệm giảng dạy và theo dõi.</p>
    <hr />

    <table border="1" cellpadding="12" style="border-collapse: collapse; width: 100%; text-align: left; border: 1px solid #ddd;">
        <thead style="background: #34495e; color: white;">
            <tr>
                <th>Class ID</th>
                <th>Class Name (Tên lớp)</th>
                <th>Schedule (Lịch học)</th>
                <th>Room (Phòng)</th>
                <th>Student Count (Sĩ số)</th>
                <th>Class Status (Trạng thái)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var c in Model)
                {
                    <tr>
                        <td>@c.ClassID</td>
                        <td><strong style="color: #2980b9; font-size: 15px;">@c.ClassName</strong></td>
                        <td><span style="color: #e67e22; font-weight: bold;">@c.Schedule</span></td>
                        <td>@c.Room</td>
                        <td>
                            <span style="background: #e17055; color: white; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold;">
                                @c.StudentCount học viên
                            </span>
                        </td>
                        <td>
                            @if (c.Status == "Active" || c.Status == "Đang mở" || c.Status == "Đang dạy")
                            {
                                <span style="color: green; font-weight: bold;">● @c.Status</span>
                            }
                            else
                            {
                                <span style="color: #7f8c8d;">● @c.Status</span>
                            }
                        </td>
                        <td>
                            <!-- Chuyển hướng sang trang danh sách học sinh kèm theo mã ID lớp cụ thể -->
                            <a href="@Url.Action("ClassStudents", "Teacher", new { classId = c.ClassID })"
                               style="background: #2ecc71; color: white; padding: 6px 12px; text-decoration: none; border-radius: 4px; font-size: 13px; font-weight: bold; display: inline-block;">
                                View Students
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; color: gray; padding: 20px;">Bạn hiện tại không phụ trách lớp học nào.</td>
                </tr>
            }
        </tbody>
    </table>

    <p style="margin-top: 25px;">
        <a href="@Url.Action("Index", "Teacher")" style="color: #3498db; text-decoration: none; font-weight: bold;">← Quay lại trang Dashboard</a>
    </p>
</div>