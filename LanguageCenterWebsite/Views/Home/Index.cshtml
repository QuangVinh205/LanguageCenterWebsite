@{
    ViewBag.Title = "Home";
}

<!-- BANNER -->
<div class="jumbotron text-center"
     style="
     background:
     linear-gradient(
        rgba(0,0,0,0.5),
        rgba(0,0,0,0.5)
     ),
     url('/Content/img/banner.png');

     background-size:cover;
     background-position:center;
     color:white;
     padding:100px 50px;
     border-radius:15px;
     margin-top:20px;">

    <h1 style="font-weight:bold;font-size:50px;">
        LANGUAGE CENTER
    </h1>

    <p class="lead">
        Learn English - Build Your Future
    </p>

    <p>
        Explore our language programs and find the course that suits you best.
    </p>

    <a href="@Url.Action("ProgramList","Home")"
       class="btn btn-warning btn-lg">
        View Programs
    </a>

</div>

<!-- NEWEST CLASSES -->
<hr />

<h2 class="text-center text-primary">
    Newest Classes
</h2>

<br />

<div class="row">

    @foreach (var item in ViewBag.NewClasses)
    {
        <div class="col-md-3">

            <div class="panel panel-primary"
                 style="box-shadow:0 3px 10px rgba(0,0,0,.15);">

                <img src="~/Content/img/class.jpg"
                     class="img-responsive"
                     style="
                        width:100%;
                        height:180px;
                        object-fit:cover;" />

                <div class="panel-heading text-center">

                    <strong>
                        @item.className
                    </strong>

                </div>

                <div class="panel-body">

                    <p>
                        <strong>Room:</strong>
                        @item.room
                    </p>

                    <p>
                        <strong>Max Students:</strong>
                        @item.maxStudents
                    </p>

                </div>

            </div>

        </div>
    }

</div>

<!-- FEATURED TEACHERS -->
<hr />

<h2 class="text-center text-primary">
    Featured Teachers
</h2>

<br />

<div class="row">

    @foreach (var teacher in ViewBag.Teachers)
    {
        <div class="col-md-3">

            <div class="panel panel-default"
                 style="
                 box-shadow:0 3px 10px rgba(0,0,0,.15);
                 min-height:280px;">

                <div class="panel-body text-center">

                    <img src="~/Content/img/teacher.jpg"
                         class="img-circle"
                         style="
                            width:120px;
                            height:120px;
                            object-fit:cover;
                            border:4px solid #0d6efd;
                            margin-bottom:15px;" />

                    <h4>
                        @teacher.fullName
                    </h4>

                    <p class="text-primary">
                        @teacher.expertise
                    </p>

                </div>

            </div>

        </div>
    }

</div>

<!-- STATISTICS -->
<hr />

<div class="row text-center">

    <div class="col-md-4">

        <div class="panel panel-info">

            <div class="panel-body">

                <h1 style="color:#0d6efd;">
                    5000+
                </h1>

                <h4>
                    Students
                </h4>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="panel panel-success">

            <div class="panel-body">

                <h1 style="color:#198754;">
                    100+
                </h1>

                <h4>
                    Classes
                </h4>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="panel panel-warning">

            <div class="panel-body">

                <h1 style="color:#ff9800;">
                    50+
                </h1>

                <h4>
                    Teachers
                </h4>

            </div>

        </div>

    </div>

</div>

<!-- WHY CHOOSE US -->
<hr />

<h2 class="text-center text-primary">
    Why Choose Us?
</h2>

<br />

<div class="row">

    <div class="col-md-4">

        <div class="panel panel-default">

            <div class="panel-body text-center">

                <h3>🎓</h3>

                <h4>Professional Teachers</h4>

                <p>
                    Experienced teachers with international teaching methods.
                </p>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="panel panel-default">

            <div class="panel-body text-center">

                <h3>📚</h3>

                <h4>Modern Programs</h4>

                <p>
                    Programs designed for practical communication and exams.
                </p>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="panel panel-default">

            <div class="panel-body text-center">

                <h3>🏆</h3>

                <h4>High Success Rate</h4>

                <p>
                    Thousands of students have achieved their goals.
                </p>

            </div>

        </div>

    </div>

</div>