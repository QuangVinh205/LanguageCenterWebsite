@model LanguageCenterWebsite.Models.Class

@{
    ViewBag.Title = "Class Detail";
}

<div class="container my-5">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <div class="row g-0">

            <div class="col-12 col-lg-6">
                <img src="@Url.Content("~/Content/img/classes/class" + Model.ClassID + ".jpg")"
                     alt="@Model.className"
                     style="width:100%;height:100%;min-height:420px;object-fit:cover;" />
            </div>

            <div class="col-12 col-lg-6">

                <div class="card-body p-5">

                    <span class="badge mb-3"
                          style="background:rgba(59,130,246,.1);color:#2563eb;font-weight:700;">
                        Active Class
                    </span>

                    <h1 class="fw-extrabold mb-3"
                        style="font-weight:800;color:#0f172a;">
                        @Model.className
                    </h1>

                    <p class="text-muted mb-4"
                       style="font-size:16px;line-height:1.7;">
                        Join this class to improve your English skills with professional teachers and a modern learning environment.
                    </p>

                    <div class="rounded-4 p-4 mb-4"
                         style="background:#f8fafc;border:1px solid #e2e8f0;">

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted fw-semibold">Room</span>
                            <span class="fw-bold text-dark">@Model.room</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted fw-semibold">Max Students</span>
                            <span class="fw-bold text-dark">@Model.maxStudents</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted fw-semibold">Program ID</span>
                            <span class="fw-bold text-dark">@Model.programID</span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span class="text-muted fw-semibold">Teacher ID</span>
                            <span class="fw-bold text-dark">@Model.teacherID</span>
                        </div>

                    </div>

                    <div class="d-flex gap-3 flex-wrap">

                        <a href="@Url.Action("ClassList","Home")"
                           class="btn btn-outline-primary px-4 py-2 fw-bold rounded-3">
                            Back to Classes
                        </a>

                        @using (Html.BeginForm("RegisterClass", "Student", FormMethod.Post))
                        {
                            @Html.Hidden("classId", Model.ClassID)

                            <button type="submit"
                                    class="btn btn-primary px-4 py-2 fw-bold rounded-3 border-0"
                                    style="background:linear-gradient(135deg,#2563eb,#7c3aed);">
                                Register Now
                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>