    </Type>
  </Table>
  <Table Name="dbo.PlacementTest" Member="PlacementTests">
    <Type Name="PlacementTest">
      <Column Name="TestID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
