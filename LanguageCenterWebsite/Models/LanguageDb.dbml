<?xml version="1.0" encoding="utf-8"?><Database Name="LanguageWeb" Class="LanguageDbDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.Class" Member="Classes">
    <Type Name="Class">
      <Column Name="ClassID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="programID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="teacherID" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="statusID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="className" Type="System.String" DbType="NVarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="room" Type="System.String" DbType="NVarChar(50)" CanBeNull="true" />
      <Column Name="maxStudents" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Association Name="Class_ClassSchedule" Member="ClassSchedules" ThisKey="ClassID" OtherKey="classID" Type="ClassSchedule" />
      <Association Name="Class_Registration" Member="Registrations" ThisKey="ClassID" OtherKey="classID" Type="Registration" />
      <Association Name="ClassStatus_Class" Member="ClassStatus" ThisKey="statusID" OtherKey="StatusID" Type="ClassStatus" IsForeignKey="true" />
      <Association Name="Teacher_Class" Member="Teacher" ThisKey="teacherID" OtherKey="TeacherID" Type="Teacher" IsForeignKey="true" />
