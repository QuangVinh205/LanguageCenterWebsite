      <Column Name="endTime" Type="System.TimeSpan" DbType="Time" CanBeNull="true" />
      <Association Name="Class_ClassSchedule" Member="Class" ThisKey="classID" OtherKey="ClassID" Type="Class" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.ClassStatus" Member="ClassStatus">
