
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Admin Panel</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background-color: #f8fafc;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            left: 0;
            top: 0;
            color: #94a3b8;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 25px rgba(0, 0, 0, 0.15);
            z-index: 1000;
        }

        .sidebar-header {
            padding: 24px;
            text-align: center;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            background: linear-gradient(135deg, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar-menu {
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            overflow-y: auto;
            flex: 1;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            color: #94a3b8;
            text-decoration: none;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sidebar a:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.06);
        }

        /* Active sidebar link */
        .sidebar a.active-link {
            color: #ffffff;
            background: rgba(59, 130, 246, 0.15);
            border-left: 4px solid #3b82f6;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

        .main-content {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 18px 32px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .topbar h4 {
            font-size: 20px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.5px;
        }

        .admin-badge {
            background: rgba(59, 130, 246, 0.08);
            color: #2563eb;
            font-weight: 700;
            font-size: 13px;
            padding: 6px 14px;
            border-radius: 9999px;
            border: 1px solid rgba(59, 130, 246, 0.15);
        }

        .content {
            padding: 32px;
            flex: 1;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">

        <div class="sidebar-header">
            Language Center
        </div>

        <div class="sidebar-menu">
            <a href="/Admin/Dashboard">
                Dashboard
            </a>

            <a href="/Admin/Program">
                Programs
            </a>

            <a href="/Admin/Teacher">
                Teachers
            </a>

            <a href="/Admin/Student">
                Students
            </a>

            <a href="/Admin/Class">
                Classes
            </a>

            <a href="/Admin/Registration">
                Registrations
            </a>

            <a href="/Admin/PlacementTest">
                Placement Tests
            </a>

            <a href="/Admin/Payment">
                Payments
            </a>
            
            <a href="/" style="margin-top: auto; border-top: 1px solid rgba(255,255,255,0.06); border-radius: 0; padding-top: 20px; color: #f43f5e;">
                Exit to Website
            </a>
        </div>

    </div>

    <!-- Main -->
    <div class="main-content">

        <!-- Header -->
        <div class="topbar d-flex justify-content-between align-items-center">

            <h4 class="mb-0">
                @ViewBag.Title
            </h4>

            <div class="admin-badge">
                Welcome, Admin
            </div>

        </div>

        <!-- Page Content -->
        <div class="content">
            @RenderBody()
        </div>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname;
            var links = document.querySelectorAll(".sidebar-menu a");
            links.forEach(function (link) {
                var href = link.getAttribute("href");
                if (href && href !== "/" && (currentPath.toLowerCase() === href.toLowerCase() || currentPath.toLowerCase().startsWith(href.toLowerCase() + "/"))) {
                    link.classList.add("active-link");
                }
            });
        });
    </script>
</body>
</html>
