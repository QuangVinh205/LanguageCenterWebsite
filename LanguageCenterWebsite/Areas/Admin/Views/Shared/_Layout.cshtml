
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background-color: #f5f7fa;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            background: #212529;
            position: fixed;
            left: 0;
            top: 0;
            color: white;
        }

        .sidebar-header {
            padding: 20px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            border-bottom: 1px solid #444;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 20px;
        }

            .sidebar a:hover {
                background: #0d6efd;
            }

        .main-content {
            margin-left: 250px;
        }

        .topbar {
            background: white;
            padding: 15px 25px;
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

        .content {
            padding: 25px;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">

        <div class="sidebar-header">
            Language Center
        </div>

        <a href="/Admin/Dashboard">
            Dashboard
        </a>

        <a href="/Admin/Program">
            Programs
        </a>

        <a href="/Admin/Teacher">
            Teachers
        </a>

        <a href="/Admin/Student">
            Students
        </a>

        <a href="/Admin/Class">
            Classes
        </a>

        <a href="/Admin/Registration">
            Registrations
        </a>
        <a href="/Admin/PlacementTest">
            Placement Tests
        </a>

        <a href="/Admin/Payment">
            Payments
        </a>

    </div>

    <!-- Main -->
    <div class="main-content">

        <!-- Header -->
        <div class="topbar d-flex justify-content-between align-items-center">

            <h4 class="mb-0">
                @ViewBag.Title
            </h4>

            <div>
                Welcome, Admin
            </div>

        </div>

        <!-- Page Content -->
        <div class="content">
            @RenderBody()
        </div>

    </div>

</body>
</html>
