@model IEnumerable<LanguageCenterWebsite.Areas.Admin.Models.RegistrationViewModel>

<h2>Registration List</h2>

<table class="table">

    <tr>
        <th>Student</th>
        <th>Class</th>
        <th>Date</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.StudentName</td>

            <td>@item.ClassName</td>

            <td>
                @item.RegistrationDate
            </td>

            <td>@item.Status</td>

            <td>

                @Html.ActionLink("Update Status","UpdateStatus", new { id = item.RegistrationID })

                |

                @Html.ActionLink("Cancel", "Cancel", new { id = item.RegistrationID })

            </td>

        </tr>
    }

</table>