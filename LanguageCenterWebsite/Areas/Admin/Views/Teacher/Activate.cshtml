@model LanguageCenterWebsite.Models.Teacher

<h2>Activate Teacher</h2>

<p>
    Are you sure you want to activate
    <strong>@Model.fullName</strong> ?
</p>

@using (Html.BeginForm("Activate", "Teacher"))
{
    @Html.HiddenFor(m => m.TeacherID)

    <button type="submit" class="btn btn-success">
        Activate
    </button>
}